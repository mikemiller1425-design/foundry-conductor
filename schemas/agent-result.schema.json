{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Foundry Conductor Agent Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "summary", "findings", "requiresHuman"],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["pass", "fail", "blocked"]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["severity", "message"],
        "properties": {
          "severity": {
            "type": "string",
            "enum": ["info", "warning", "error"]
          },
          "message": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "requiresHuman": {
      "type": "boolean"
    }
  }
}

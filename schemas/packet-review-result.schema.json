{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Foundry Package 2a Packet Review",
  "type": "object",
  "additionalProperties": false,
  "required": ["verdict", "candidateSha256", "packetId", "packetSha256", "summary", "findings", "requiresHuman"],
  "properties": {
    "verdict": {"type": "string", "enum": ["pass", "findings_complete", "blocked"]},
    "candidateSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "packetId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$"},
    "packetSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "summary": {"type": "string", "minLength": 1},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["severity", "category", "dedupKey", "message", "requiredChange", "evidenceLocations"],
        "properties": {
          "severity": {"type": "string", "enum": ["warning", "error"]},
          "category": {"type": "string", "minLength": 1},
          "dedupKey": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$"},
          "message": {"type": "string", "minLength": 1},
          "requiredChange": {"type": "string", "minLength": 1},
          "evidenceLocations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "requiresHuman": {"type": "boolean"}
  }
}
